<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pqcaps</groupId>
    <artifactId>pqc-aps</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>attack-lab</artifactId>
  <name>PQC-APS :: Attack Lab</name>
  <description>
    Attack demonstrations and three-mode security matrix:
    CLASSICAL-VULNERABLE vs CLASSICAL-HARDENED vs HYBRID.
    Downgrade, MITM, Replay, GCM Nonce Reuse, and Ciphertext Tampering.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>classical</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>secure-channel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>hybrid-kex</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>pq-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>attack-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.pqcaps.attacklab.AttackLabRunner</mainClass>
              <addClasspath>true</addClasspath>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
