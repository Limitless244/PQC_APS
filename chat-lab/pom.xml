<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pqcaps</groupId>
    <artifactId>pqc-aps</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>chat-lab</artifactId>
  <name>PQC-APS :: Chat Lab</name>
  <description>
    Distributed Chat Lab running Alice (Client), Mallory (Attacker TCP Proxy), and Bob (Server)
    as independent Spring Boot roles over real localhost TCP sockets with live SSE monitoring.
  </description>

  <dependencies>
    <!-- Spring Boot Web -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Project Modules -->
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>classical</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>hybrid-kex</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>pq-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>secure-channel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>attack-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>attack-lab</artifactId>
    </dependency>

    <!-- JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
