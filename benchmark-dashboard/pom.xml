<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pqcaps</groupId>
    <artifactId>pqc-aps</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>benchmark-dashboard</artifactId>
  <name>PQC-APS :: Benchmark Dashboard</name>
  <description>
    Spring Boot backend (REST + SSE) serving JMH benchmark results, live attack-event
    feeds, and crypto scanner reports. Hosts the Chart.js dashboard frontend.
  </description>

  <properties>
    <!-- Prevent Eclipse JDT incremental APT from conflicting with JMH annotation processor -->
    <m2e.apt.activation>disabled</m2e.apt.activation>
  </properties>

  <dependencies>
    <!-- Spring Boot Web -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JMH for in-process benchmarks -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Our own modules -->
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>classical</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>hybrid-kex</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>pq-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>secure-channel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>attack-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>attack-lab</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>crypto-scanner</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>crypto-agility</artifactId>
    </dependency>

    <!-- JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring Boot executable jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
