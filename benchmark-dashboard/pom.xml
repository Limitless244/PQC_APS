<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pqcaps</groupId>
    <artifactId>pqc-aps</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>benchmark-dashboard</artifactId>
  <name>PQC-APS :: Benchmark Dashboard</name>
  <description>
    Spring Boot backend (REST + WebSocket) serving JMH benchmark results and
    live attack-event feeds. Hosts the React/Chart.js dashboard frontend.
  </description>

  <dependencies>
    <!-- Spring Boot Web + WebSocket -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- JMH for in-process benchmarks -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Our own modules -->
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>hybrid-kex</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>pq-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>secure-channel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>attack-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pqcaps</groupId>
      <artifactId>crypto-agility</artifactId>
    </dependency>

    <!-- JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring Boot executable jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
