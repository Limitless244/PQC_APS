# ── Maven ──────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
!**/src/main/**/*.jar   # local test fixtures only

# ── Maven wrapper downloaded binary ────────────────────────────────────
.mvn/wrapper/maven-wrapper.jar

# ── IntelliJ IDEA ──────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── VS Code ────────────────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── Eclipse ────────────────────────────────────────────────────────────
.classpath
.project
.settings/

# ── OS junk ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Node / npm (dashboard frontend) ────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── JMH generated files ────────────────────────────────────────────────
jmh-*.json
*.jmh

# ── Sensitive material — NEVER commit these ─────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.bks
secrets.properties
application-secrets.yml

# ── Log files ──────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary / scratch ────────────────────────────────────────────────
*.tmp
*.bak
*.swp

# ── Generated data directory ───────────────────────────────────────────
data/*
!data/sample/
!data/sample/**

